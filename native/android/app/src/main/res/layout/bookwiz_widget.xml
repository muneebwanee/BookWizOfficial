<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background"><TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BOOKWIZ · YOUR BOOK" android:textSize="11sp" android:textColor="@color/widget_accent" android:maxLines="2" android:ellipsize="end" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your next chapter" android:textSize="18sp" android:textColor="@color/widget_ink" android:maxLines="2" android:ellipsize="end" android:fontFamily="serif" android:layout_marginTop="10dp"/><TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 words" android:textSize="24sp" android:textColor="@color/widget_ink" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium"/><TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pick up where you left off" android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="5dp"/><TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Continue writing →" android:textSize="12sp" android:textColor="@color/widget_accent" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium"/></LinearLayout>
