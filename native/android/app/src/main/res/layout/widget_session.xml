<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BOOKWIZ / FOCUS" android:textSize="10sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"><TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="One good passage" android:textSize="19sp" android:textColor="@color/widget_ink" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="serif"/><TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="25 minutes" android:textSize="28sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="10dp" android:fontFamily="sans-serif-light"/><Chronometer android:id="@+id/widget_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="34sp" android:textColor="@color/widget_ink" android:fontFamily="sans-serif-light" android:visibility="gone"/><TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a time. Stay with the page." android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="6dp"/></LinearLayout><TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start a session →" android:textSize="12sp" android:textColor="@color/widge