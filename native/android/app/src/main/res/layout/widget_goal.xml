<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
<TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TODAY’S PAGE" android:textSize="10sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"/><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical"><TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 / 500 words" android:textSize="24sp" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif-medium"/><ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:progress="0" android:progressTint="@color/widget_accent" android:progressBackgroundTint="@color/widget_track" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/><TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="500 words to your next page" android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" /></LinearLayout><TextView android:id="@+id/widget_goal_write" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Make room for a few words →" android:textSize="12sp" android:textColor="@color/widget_accent" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:minHeight="28dp" android:gravity="center_vertical"/>
</LinearLayout>
